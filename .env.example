DATABASE_URL=postgres://postgres:postgres@localhost:5432/qualityruntime

# Public origin the server is reached at.
BETTER_AUTH_URL=http://localhost:3000

# Used for encryption, signing, and hashing. At least 32 high-entropy
# characters; generate one with `openssl rand -base64 32`. Left empty on
# purpose, so a copied example cannot become a known production secret.
BETTER_AUTH_SECRET=
